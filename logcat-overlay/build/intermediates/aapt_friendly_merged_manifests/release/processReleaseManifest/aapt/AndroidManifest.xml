<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.devtechdesign.android.logcat" >

    <uses-sdk android:minSdkVersion="24" />

    <!--
         READ_LOGS lets the overlay show every app's logs, not just the host app's.
         Not granted on install; grant once per device:
         adb shell pm grant <app-package> android.permission.READ_LOGS
    -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

</manifest>